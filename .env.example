FOOTBALL_API_KEY=
FOOTBALL_API_HOST=v3.football.api-sports.io
NEWS_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEWSLETTER_TOKEN_SECRET=
RESEND_API_KEY=

# AdSense Phase 1: disabled. IDs are public account identifiers, never secrets.
# All serving gates plus a code-reviewed placement are required before loading.
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_MANUAL_SLOT_ID=
ADSENSE_LAUNCH_APPROVED=false
# These are preparation/validation gates, not substitutes for nonce CSP review.
ADSENSE_CSP_PREPARED=false
ADSENSE_CSP_VALIDATED=false
# Exact generated HTTPS fundingchoicesmessages.google.com/i/pub-ID URL.
# Publishing the message and configuring consent mode are manual account tasks.
GOOGLE_CMP_ENABLED=false
GOOGLE_CMP_SCRIPT_URL=
# Local diagnostics only; no telemetry is sent by this hook.
ADSENSE_MONITORING_ENABLED=false
